{
  "name": "catch-that-dih",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prebuild": "npm run data && vitest run",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "data": "tsx tools/build-data.ts",
    "art": "python3 tools/art/build_all.py",
    "lint": "eslint . && tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "phaser": "4.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.7",
    "csv-parse": "7.0.3",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
